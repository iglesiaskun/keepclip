{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keepclip",
  "identifier": "io.github.iglesiaskun.keepclip",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "keepclip",
    "copyright": "Copyright (c) 2026 Pedro Iglesias"
  }
}
